# Supabase (Wartości publiczne dla klienta mobilnego i webowego)
# Format: URL = https://<20 znaków>.supabase.co; klucz = anon JWT (eyJ…) tego samego projektu albo sb_publishable_…
# Nigdy klucz service_role / sb_secret_. Kontrola przed buildem: npm run preflight (na EAS: eas env:create --force).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Sign-In (Client IDs z Google Cloud Console)
# Format: <numer>-<id>.apps.googleusercontent.com; identyfikator web musi różnić się od iOS,
# a iOS musi pasować do iosUrlScheme w app.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Sekrety Supabase (Edge Functions) — NIGDY w kliencie (bez przedrostka EXPO_PUBLIC_)
# Ustawiane przez człowieka: supabase secrets set GROQ_API_KEY=... GEMINI_API_KEY=...
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# AI Provider i Konfiguracja Modeli dla Edge Functions (_shared/ai)
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3

LLM_STRUCTURE_PROVIDER=groq
LLM_STRUCTURE_MODEL=openai/gpt-oss-120b

LLM_DIGEST_PROVIDER=groq
LLM_DIGEST_MODEL=openai/gpt-oss-120b

LLM_LINK_PROVIDER=groq
LLM_LINK_MODEL=openai/gpt-oss-120b

LLM_CHAT_PROVIDER=gemini
LLM_CHAT_MODEL=gemini-2.0-flash

EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1536
