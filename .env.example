# Supabase (Wartości publiczne dla klienta mobilnego i webowego)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Sign-In (Client IDs z Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Sekrety Supabase (Edge Functions) — NIGDY w kliencie (bez przedrostka EXPO_PUBLIC_)
# Ustawiane przez człowieka: supabase secrets set GROQ_API_KEY=... GEMINI_API_KEY=...
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
